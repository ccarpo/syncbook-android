namespace syncbook {};

enum BlockKind {
    "Paragraph",
    "TaskItem",
};

dictionary Block {
    string id;
    BlockKind kind;
    string text;
    boolean checked;
};

interface Greeting {
    constructor();
    string hello(string name);
};

interface SyncDoc {
    constructor();
    void apply_update(sequence<u8> update);
    sequence<u8> state_vector();
    sequence<u8> encode_state_as_update(sequence<u8> state_vector);
    sequence<sequence<u8>> handle_message(sequence<u8> message);
    sequence<Block> blocks();
    void insert_text(string block_id, u32 offset, string text);
    void delete_text(string block_id, u32 offset, u32 length);
    void set_checked(string block_id, boolean checked);
    void split_block(string block_id, u32 offset);
    void toggle_task_list(string block_id);
};
